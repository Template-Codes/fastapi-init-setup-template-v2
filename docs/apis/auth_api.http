### (TESTED) - WORKING AS INTENDED
# 1. User Registration (Public Access) 
# Submits a new user registration. Status flag is set to PENDING upon success.
POST {{host}}/api/public/auth/register
Content-Type: application/json
X-Header: {{secret_header_value}}

{
    "username": "user8",
    "email": "user8@xcom.com",
    "plain_password": "Password@123"
}


### (TESTED) - WORKING AS INTENDED
# 2. User Authentication / Login (Public Access)
# Authenticates user credentials. Returns JWT payload and sets HTTP-Only Cookies (access_token & refresh_token).
# Try with seeded Super Admin credentials: username="superadmin1", plain_password="Admin@123456"
# @name login
POST {{host}}/api/public/auth/login
Content-Type: application/json
X-Header: {{secret_header_value}}

{
    "username": "superadmin1",
    "plain_password": "Password@123"
}


### (TESTED) - WORKING AS INTENDED
# 3. Refresh Access Token (Public Access)
# Uses the refresh_token stored in HTTP-Only cookie (automatically sent by REST Client cookie jar)
# or passed explicitly via Cookie header to issue a new access_token.
POST {{host}}/api/public/auth/refresh-token
Content-Type: application/json
X-Header: {{secret_header_value}}
# Cookie: refresh_token=YOUR_REFRESH_TOKEN_HERE


### (TESTED) - WORKING AS INTENDED
# 4. List Pending Registrations (Admin Only)
# Guarded by require_role(SUPER_ADMIN, ADMIN).
# Returns array of pending user registration requests.
# Uses active access_token cookie from login (#2).
GET {{host}}/api/private/admin/users/pending-registrations
Content-Type: application/json
X-Header: {{secret_header_value}}


### (TESTED) - WORKING AS INTENDED
# 5. Approve User Registration (Admin Only)
# Guarded by require_role(SUPER_ADMIN, ADMIN).
# Transitions status from PENDING to ACTIVE and assigns initial role (default: STAFF_USER).
# Replace :user_id with the pending user's UUID from #4
POST {{host}}/api/private/admin/users/01a12dff-4bfb-7531-aacb-81b4527567f0/approve
Content-Type: application/json
X-Header: {{secret_header_value}}

{
    "role_name": "STAFF_USER"
}


### (TESTED) - WORKING AS INTENDED
# 6. Reject User Registration (Admin Only)
# Guarded by require_role(SUPER_ADMIN, ADMIN).
# Transitions status from PENDING to INACTIVE for audit retention.
# Replace :user_id with the pending user's UUID from #4
POST {{host}}/api/private/admin/users/01a12dff-4bfb-7531-aacb-81b4527567f0/reject
Content-Type: application/json
X-Header: {{secret_header_value}}
