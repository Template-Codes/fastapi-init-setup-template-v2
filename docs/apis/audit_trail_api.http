# ==============================================================================
# AUDIT TRAIL ADMINISTRATIVE INSPECTION APIS
# ==============================================================================
# All endpoints require an active session cookie (access_token) or Bearer token
# and require administrative role (SUPER_ADMIN or ADMIN).
# ==============================================================================

###
# 1. Admin List Audit Logs (Default Paginated View)
# Retrieves paginated activity audit logs ordered by newest first.
# Guarded by require_role(SUPER_ADMIN, ADMIN).
GET {{host}}/api/private/admin/audit-logs?page=1&limit=50
Content-Type: application/json
X-Header: {{secret_header_value}}


###
# 2. Admin Filter Audit Logs by System Module
# Filters logs by module (e.g. AUTHENTICATION, PROFILE, SESSION, RBAC, SYSTEM).
GET {{host}}/api/private/admin/audit-logs?module=AUTHENTICATION&page=1&limit=20
Content-Type: application/json
X-Header: {{secret_header_value}}


###
# 3. Admin Filter Audit Logs by Action and Severity
# Filters logs by action (e.g. CREATE, UPDATE, DELETE, LOGIN) and severity (INFO, WARNING, CRITICAL).
GET {{host}}/api/private/admin/audit-logs?action=CREATE&severity=INFO&page=1&limit=20
Content-Type: application/json
X-Header: {{secret_header_value}}


###
# 4. Admin Filter Audit Logs by Resource and Target ID
# Filters logs by target resource (e.g. USER, ROLE, SESSION) and specific target ID.
GET {{host}}/api/private/admin/audit-logs?resource=ROLE&target_id=role-123
Content-Type: application/json
X-Header: {{secret_header_value}}


###
# 5. Admin Retrieve Audit Log Detail by UUID
# Retrieves full detail of a specific activity audit log entry by UUID.
# Replace :audit_log_id with an existing audit log UUID.
GET {{host}}/api/private/admin/audit-logs/00000000-0000-0000-0000-000000000000
Content-Type: application/json
X-Header: {{secret_header_value}}
